{
  "manifest_version": 3,
  "name": "Classroom++",
  "short_name": "Classroom++",
  "version": "0.1.1",
  "description": "Makes Google Classroom Classwork topics vertically scrollable: up to 5 posts at a time, centered on the newest post, with a Show all toggle.",
  "minimum_chrome_version": "116",
  "author": "Classroom++",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Classroom++",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://classroom.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "homepage_url": "https://classroom.google.com/"
}
